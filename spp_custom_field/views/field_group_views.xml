<odoo>
    <!-- Field Group Tree View -->
    <record id="view_field_group_tree" model="ir.ui.view">
        <field name="name">spp.custom.field.group.tree</field>
        <field name="model">spp.custom.field.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="target_type" />
                <field name="description" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Field Group Form View -->
    <record id="view_field_group_form" model="ir.ui.view">
        <field name="name">spp.custom.field.group.form</field>
        <field name="model">spp.custom.field.group</field>
        <field name="arch" type="xml">
            <form string="Field Group">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="target_type" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Field Group Search View -->
    <record id="view_field_group_search" model="ir.ui.view">
        <field name="name">spp.custom.field.group.search</field>
        <field name="model">spp.custom.field.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="target_type" />
                <separator/>
                <filter string="Group Fields" name="filter_group" domain="[('target_type', '=', 'grp')]"/>
                <filter string="Individual Fields" name="filter_individual" domain="[('target_type', '=', 'indv')]"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter string="Target Type" name="group_by_target_type" context="{'group_by': 'target_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Field Group Action -->
    <record id="action_field_group" model="ir.actions.act_window">
        <field name="name">Field Groups</field>
        <field name="res_model">spp.custom.field.group</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_field_group_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Field Group
            </p>
            <p>
                Field groups help organize custom fields in the user interface.
                Fields can be assigned to groups for better visual organization.
            </p>
        </field>
    </record>

    <!-- Menu Item - Will be placed under Custom Fields parent if spp_custom_fields_ui is installed -->
    <menuitem
        id="menu_field_group"
        name="Field Groups"
        action="action_field_group"
        parent="g2p_registry_base.g2p_configuration_menu_root"
        sequence="34"
        groups="g2p_registry_base.group_g2p_admin"
    />
</odoo>
