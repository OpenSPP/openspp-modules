<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_data_exporter_templates_tree" model="ir.ui.view">
        <field name="name">view_data_exporter_templates_tree</field>
        <field name="model">spp.data.exporter.templates</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree create="true" edit="true" delete="false" editable="bottom">
                <field name="name" />
                <field name="model_ids" widget="many2many_tags" options="{'no_create': True}" />
                <field name="module_ids" readonly="1" force_save="1" />
                <field name="active" column_invisible="1" />
            </tree>
        </field>
    </record>


    <record id="action_data_exporter_templates" model="ir.actions.act_window">
        <field name="name">Data Exporter Templates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.data.exporter.templates</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Export data templates.
            </p><p>
                Click the create button to set up a new template.
            </p>
        </field>
    </record>

    <record id="action_data_exporter_templates_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_data_exporter_templates_tree" />
        <field name="act_window_id" ref="action_data_exporter_templates" />
    </record>

    <menuitem
        id="menu_data_exporter_templates"
        name="Export Templates"
        action="action_data_exporter_templates"
        parent="spp_demo_common.menu_import_export"
        sequence="60"
        groups="g2p_registry_base.group_g2p_admin,g2p_registry_base.group_g2p_registrar"
    />

</odoo>
