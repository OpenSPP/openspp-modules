<odoo>
    <!-- Tree View for Group Fields with Grouping Support -->
    <record id="view_custom_fields_ui_tree_group" model="ir.ui.view">
        <field name="name">view_custom_fields_ui_tree_group</field>
        <field name="model">ir.model.fields</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="field_description" />
                <field name="ttype" />
                <field name="field_category" />
                <field name="field_group_id" />
                <field name="target_type" column_invisible="1" />
                <field name="index" optional="hide" />
                <field name="store" optional="hide" />
                <field name="readonly" optional="hide" />
                <field name="relation" optional="hide" />
            </tree>
        </field>
    </record>

    <!-- Tree View for Individual Fields with Grouping Support -->
    <record id="view_custom_fields_ui_tree_individual" model="ir.ui.view">
        <field name="name">view_custom_fields_ui_tree_individual</field>
        <field name="model">ir.model.fields</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="field_description" />
                <field name="ttype" />
                <field name="field_category" />
                <field name="field_group_id" />
                <field name="target_type" column_invisible="1" />
                <field name="index" optional="hide" />
                <field name="store" optional="hide" />
                <field name="readonly" optional="hide" />
                <field name="relation" optional="hide" />
            </tree>
        </field>
    </record>

    <!-- Search View with Grouping Support -->
    <record id="view_custom_fields_ui_search" model="ir.ui.view">
        <field name="name">view_custom_fields_ui_search</field>
        <field name="model">ir.model.fields</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="field_description" />
                <field name="field_group_id" />
                <field name="ttype" />
                <field name="field_category" />
                <separator />
                <filter
                    string="Custom Fields"
                    name="filter_custom"
                    domain="[('field_category', '=', 'cst')]"
                />
                <filter
                    string="Calculated Fields"
                    name="filter_calculated"
                    domain="[('field_category', '=', 'ind')]"
                />
                <separator />
                <group expand="1" string="Group By">
                    <filter
                        string="Field Group"
                        name="group_by_field_group"
                        context="{'group_by': 'field_group_id'}"
                    />
                    <filter
                        string="Field Category"
                        name="group_by_field_category"
                        context="{'group_by': 'field_category'}"
                    />
                    <filter string="Field Type" name="group_by_ttype" context="{'group_by': 'ttype'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="view_custom_fields_ui_form" model="ir.ui.view">
        <field name="name">view_custom_fields_ui_form</field>
        <field name="model">ir.model.fields</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Custom Fields">
              <sheet>
                      <group>
                          <group>
                              <field name="prefix" />
                              <field name="name" invisible="1" />
                              <field name="draft_name" />
                              <field name="field_description" />
                              <field name="model_id" readonly="1" force_save="1" />
                              <field name="sequence" />
                          </group>
                          <group>
                              <field name="ttype" readonly="field_category == 'ind'" />
                              <field name="target_type" />
                              <field name="field_category" />
                              <field name="has_presence" invisible="field_category != 'ind'" />
                              <field name="field_group_id" />
                              <field name="help" />
                          </group>
                      </group>
                      <field name="ttype" invisible="1" />
                      <notebook>
                          <page
                            name="base"
                            string="Properties"
                            invisible="field_category not in ['cst', 'ind']"
                        >
                              <group string="Base Properties" invisible="field_category != 'cst'">
                                  <group>
                                      <field name="required" />
                                      <field name="readonly" />
                                      <field name="index" groups="base.group_no_one" />
                                      <field name="copied" groups="base.group_no_one" />
                                  </group>
                                  <group>
                                      <field
                                        name="translate"
                                        readonly="ttype not in ['char','text','html']"
                                        invisible="ttype not in ['char','text','html']"
                                    />
                                      <field
                                        name="size"
                                        groups="base.group_no_one"
                                        readonly="ttype not in ['char','reference']"
                                        invisible="ttype not in ['char','reference']"
                                    />
                                      <field
                                        name="relation"
                                        required="ttype in ['many2one','one2many','many2many']"
                                        readonly="ttype not in ['many2one','one2many','many2many']"
                                        invisible="ttype not in ['many2one','one2many','many2many']"
                                    />
                                      <field
                                        name="group_expand"
                                        groups="base.group_no_one"
                                        readonly="ttype not in ['many2one', 'selection']"
                                        invisible="ttype not in ['many2one', 'selection']"
                                    />
                                      <field
                                        name="on_delete"
                                        groups="base.group_no_one"
                                        readonly="ttype != 'many2one'"
                                        invisible="ttype != 'many2one'"
                                    />
                                      <field
                                        name="relation_field"
                                        required="ttype == 'one2many'"
                                        readonly="ttype != 'one2many'"
                                        invisible="ttype != 'one2many'"
                                    />
                                      <field
                                        name="relation_table"
                                        groups="base.group_no_one"
                                        readonly="ttype != 'many2many' or state != 'manual'"
                                        invisible="ttype != 'many2many' or state != 'manual'"
                                    />
                                      <field
                                        name="column1"
                                        groups="base.group_no_one"
                                        readonly="ttype != 'many2many' or state != 'manual'"
                                        invisible="ttype != 'many2many' or state != 'manual'"
                                    />
                                      <field
                                        name="column2"
                                        groups="base.group_no_one"
                                        readonly="ttype != 'many2many' or state != 'manual'"
                                        invisible="ttype != 'many2many' or state != 'manual'"
                                    />
                                      <field
                                        name="domain"
                                        groups="base.group_no_one"
                                        readonly="ttype not in ['many2one','one2many','many2many']"
                                        invisible="ttype not in ['many2one','one2many','many2many']"
                                    />
                                  </group>
                              </group>
                              <group
                                readonly="ttype not in ['selection','reference']"
                                invisible="ttype not in ['selection','reference']"
                            >
                                  <field name="selection_ids">
                                      <tree editable="bottom">
                                          <field name="sequence" widget="handle" />
                                          <field name="value" />
                                          <field name="name" />
                                      </tree>
                                  </field>
                              </group>
                              <group string="Advanced Properties" invisible="field_category != 'ind'">

                                  <field name="store" />
                                  <field name="kinds" widget="many2many_tags" />
                                  <field name="related" />
                                  <field name="depends" />
                                  <field name="compute" widget="ace" options="{'mode': 'python'}" />
                              </group>
                              <div invisible="1">
                                  <h3>How to define a computed field</h3>
                                  <p>Computed fields are defined with the fields
                                  <strong>Dependencies</strong> and <strong>Compute</strong>.</p>
                                  <p>The field <strong>Dependencies</strong> lists the fields that
                                  the current field depends on. It is a comma-separated list of
                                  field names, like <code>name, size</code>. You can also refer to
                                  fields accessible through other relational fields, for instance
                                  <code>partner_id.company_id.name</code>.</p>
                                  <p>The field <strong>Compute</strong> is the Python code to
                                  compute the value of the field on a set of records. The value of
                                  the field must be assigned to each record with a dictionary-like
                                  assignment.</p>
                                  <pre>
                                    for record in self:
                                        record['size'] = len(record.name)
                                  </pre>
                                  <p>The only predefined variables are</p>
                                  <ul>
                                      <li><code>self</code> (the set of records to compute)</li>
                                      <li><code>datetime</code> (Python module)</li>
                                      <li><code>dateutil</code> (Python module)</li>
                                      <li><code>time</code> (Python module)</li>
                                  </ul>
                                  <p>Other features are accessible through <code>self</code>, like
                                  <code>self.env</code>, etc.</p>
                              </div>
                          </page>
                          <!--<page name="groups" string="Access Rights">
                              <field name="groups"/>
                          </page>-->
                          <page name="misc" string="Miscellaneous" groups="base.group_no_one" invisible="1">
                              <group>
                                  <field name="state" />
                                  <field name="modules" />
                              </group>
                          </page>
                      </notebook>
                  </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Group Custom Fields -->
    <record id="action_custom_fields_ui_group" model="ir.actions.act_window">
        <field name="name">Group Custom Fields</field>
        <field name="res_model">ir.model.fields</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_custom_fields_ui_search" />
        <field name="context">{
            'default_model_id': ref('base.model_res_partner'),
            'default_model': 'res.partner',
            'default_target_type': 'grp',
            'search_default_group_by_field_group': 1,
        }</field>
        <field
            name="domain"
        >[('model_id', '=', ref('base.model_res_partner')), ('state', '=', 'manual'), ('target_type', '=', 'grp')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_custom_fields_ui_tree_group')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_custom_fields_ui_form')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Custom Field for Groups
            </p>
            <p>
                Define custom fields that will appear on group registrant profiles.
                You can organize fields into groups for better UI organization.
            </p>
        </field>
    </record>

    <!-- Action for Individual Custom Fields -->
    <record id="action_custom_fields_ui_individual" model="ir.actions.act_window">
        <field name="name">Individual Custom Fields</field>
        <field name="res_model">ir.model.fields</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_custom_fields_ui_search" />
        <field name="context">{
            'default_model_id': ref('base.model_res_partner'),
            'default_model': 'res.partner',
            'default_target_type': 'indv',
            'search_default_group_by_field_group': 1,
        }</field>
        <field
            name="domain"
        >[('model_id', '=', ref('base.model_res_partner')), ('state', '=', 'manual'), ('target_type', '=', 'indv')]</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_custom_fields_ui_tree_individual')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_custom_fields_ui_form')})]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Custom Field for Individuals
            </p>
            <p>
                Define custom fields that will appear on individual registrant profiles.
                You can organize fields into groups for better UI organization.
            </p>
        </field>
    </record>

    <!-- Parent Menu for Custom Fields -->
    <menuitem
        id="menu_custom_fields_ui_root"
        name="Custom Fields"
        parent="g2p_registry_base.g2p_configuration_menu_root"
        sequence="33"
        groups="g2p_registry_base.group_g2p_admin"
    />

    <!-- Menu Item for Group Fields -->
    <menuitem
        id="menu_custom_fields_ui_group"
        name="Group Fields"
        action="action_custom_fields_ui_group"
        parent="menu_custom_fields_ui_root"
        sequence="10"
        groups="g2p_registry_base.group_g2p_admin"
    />

    <!-- Menu Item for Individual Fields -->
    <menuitem
        id="menu_custom_fields_ui_individual"
        name="Individual Fields"
        action="action_custom_fields_ui_individual"
        parent="menu_custom_fields_ui_root"
        sequence="20"
        groups="g2p_registry_base.group_g2p_admin"
    />

    <!-- Move Field Groups menu under Custom Fields parent -->
    <menuitem id="spp_custom_field.menu_field_group" parent="menu_custom_fields_ui_root" sequence="30" />

</odoo>
