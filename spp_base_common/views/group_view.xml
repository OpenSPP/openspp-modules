<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_groups_base_custom_form" model="ir.ui.view">
        <field name="name">view_groups_base_custom_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="g2p_registry_group.view_groups_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='related_2_ids']/tree/field[@name='relation']" position="after">
                <field name="relation_inverse" />
            </xpath>
            <xpath expr="//field[@name='related_2_ids']/tree/" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='related_2_ids']/tree/" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
