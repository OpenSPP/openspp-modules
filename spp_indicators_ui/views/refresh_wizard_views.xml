<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_openspp_metrics_refresh_wizard_form" model="ir.ui.view">
        <field name="name">openspp.metrics.refresh.wizard.form</field>
        <field name="model">openspp.metrics.refresh.wizard</field>
        <field name="arch" type="xml">
            <form string="Refresh Metrics">
                <sheet>
                    <group>
                        <field name="partner_id" readonly="1" />
                        <field name="metric" placeholder="household.size" />
                        <field name="period_key" />
                    </group>
                    <footer>
                        <button string="Refresh" type="object" name="action_refresh" class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_openspp_refresh_metrics_wizard" model="ir.actions.act_window">
        <field name="name">Refresh Metrics</field>
        <field name="res_model">openspp.metrics.refresh.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
