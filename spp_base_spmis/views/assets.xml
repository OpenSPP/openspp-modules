<odoo>
    <!-- Load modern JS for new web client -->
    <template id="assets_backend" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/spp_base_spmis/static/src/js/import_action.esm.js" />
        </xpath>
    </template>

    <!-- Load legacy JS for compatibility -->
    <template id="assets_backend_legacy" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/spp_base_spmis/static/src/legacy/js/import_action.js" />
        </xpath>
    </template>
</odoo>
