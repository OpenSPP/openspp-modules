<odoo>
    <!-- Tree View -->
    <record id="view_partner_search_field_tree" model="ir.ui.view">
        <field name="name">spp.partner.search.field.tree</field>
        <field name="model">spp.partner.search.field</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="field_name" />
                <field name="field_type" />
                <field name="target_type" />
                <field name="active" widget="boolean_toggle" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_partner_search_field_form" model="ir.ui.view">
        <field name="name">spp.partner.search.field.form</field>
        <field name="model">spp.partner.search.field</field>
        <field name="arch" type="xml">
            <form string="Partner Search Field">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active" />
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Name, Phone, Email..." />
                            <field name="field_id" options="{'no_create': True, 'no_create_edit': True}" />
                            <field name="field_name" invisible="1" />
                        </group>
                        <group>
                            <field name="field_type" readonly="1" />
                            <field name="target_type" widget="radio" />
                            <field name="sequence" />
                            <field name="active" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_partner_search_field_search" model="ir.ui.view">
        <field name="name">spp.partner.search.field.search</field>
        <field name="model">spp.partner.search.field</field>
        <field name="arch" type="xml">
            <search string="Search Partner Search Fields">
                <field name="name" />
                <field name="field_name" />
                <field name="field_type" />
                <filter string="Active" name="active" domain="[('active', '=', True)]" />
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]" />
                <group expand="0" string="Group By">
                    <filter
                        string="Field Type"
                        name="group_by_field_type"
                        context="{'group_by': 'field_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_partner_search_field" model="ir.actions.act_window">
        <field name="name">Registry Search Fields</field>
        <field name="res_model">spp.partner.search.field</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first searchable registry field!
            </p>
            <p>
                Configure which registry fields should be available for searching in the registry search interface.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_partner_search_field"
        name="Registry Search Fields"
        parent="base.menu_administration"
        action="action_partner_search_field"
        sequence="100"
    />
</odoo>
