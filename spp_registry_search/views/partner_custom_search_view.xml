<odoo>
    <!-- Custom Partner Search Form View -->
    <record id="view_partner_custom_search_form" model="ir.ui.view">
        <field name="name">partner.custom.search.form</field>
        <field name="model">res.partner</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form string="Partner Search" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="id" invisible="1" options="{'spp_custom_search': True}" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Custom Partner Search Tree View -->
    <record id="view_partner_custom_search_tree" model="ir.ui.view">
        <field name="name">partner.custom.search.tree</field>
        <field name="model">res.partner</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="name" />
                <field name="email" />
                <field name="phone" />
                <field name="mobile" />
                <field name="city" />
                <field name="country_id" />
                <field name="is_group" invisible="1" />
            </tree>
        </field>
    </record>

    <!-- Individual Search Client Action -->
    <record id="action_individual_search" model="ir.actions.client">
        <field name="name">Individuals</field>
        <field name="tag">partner_search_action</field>
        <field name="target">current</field>
        <field
            name="context"
        >{'default_partner_type': 'individual', 'hide_partner_type': True, 'form_view_ref': 'g2p_registry_individual.view_individuals_form'}</field>
    </record>

    <!-- Group Search Client Action -->
    <record id="action_group_search" model="ir.actions.client">
        <field name="name">Groups</field>
        <field name="tag">partner_search_action</field>
        <field name="target">current</field>
        <field
            name="context"
        >{'default_partner_type': 'group', 'hide_partner_type': True, 'form_view_ref': 'g2p_registry_group.view_groups_form'}</field>
    </record>

    <!-- Override Individual Menu to use Search Action -->
    <menuitem
        id="g2p_registry_individual.menu_individuals_list"
        name="Individuals"
        parent="g2p_registry_base.g2p_main_menu_root"
        action="action_individual_search"
        sequence="20"
        groups="g2p_registry_base.group_g2p_admin,g2p_registry_base.group_g2p_registrar"
    />

    <!-- Override Group Menu to use Search Action -->
    <menuitem
        id="g2p_registry_group.menu_groups_list"
        name="Groups"
        parent="g2p_registry_base.g2p_main_menu_root"
        action="action_group_search"
        sequence="10"
        groups="g2p_registry_base.group_g2p_admin,g2p_registry_base.group_g2p_registrar"
    />
</odoo>
