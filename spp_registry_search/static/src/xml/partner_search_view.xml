<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="spp_registry_search.PartnerSearchAction" owl="1">
        <div class="o_partner_search_action vh-100 overflow-auto">
            <div class="container-fluid py-4 px-4">
                <!-- Search Form -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-primary text-white py-3">
                                <h4 class="mb-0">
                                    <t t-if="state.partnerType === 'individual'">
                                        <i class="fa fa-search me-2" /> Individual Search
                                    </t>
                                    <t t-elif="state.partnerType === 'group'">
                                        <i class="fa fa-search me-2" /> Group Search
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-search me-2" /> Registry Search
                                    </t>
                                </h4>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3 align-items-start">
                                    <t t-if="!this.hidePartnerType">
                                        <div class="col-lg-2 col-md-3">
                                            <label for="partner_type" class="form-label fw-bold">
                                                <i class="fa fa-users me-1" /> Registrant Type
                                            </label>
                                            <select
                                                id="partner_type"
                                                class="form-select form-select-lg"
                                                t-model="state.partnerType"
                                                t-on-change="onPartnerTypeChange"
                                            >
                                                <option value="individual">Individual</option>
                                                <option value="group">Group</option>
                                            </select>
                                        </div>
                                    </t>
                                    <div class="col-lg-3 col-md-4">
                                        <label for="search_filter" class="form-label fw-bold">
                                            <i class="fa fa-filter me-1" /> Filters
                                            <small class="text-muted">(Hold Ctrl/Cmd for multiple)</small>
                                        </label>
                                        <select
                                            id="search_filter"
                                            class="form-select"
                                            multiple="true"
                                            size="4"
                                            t-on-change="onFilterChange"
                                            style="height: 46px; overflow-y: auto;"
                                        >
                                            <t
                                                t-foreach="state.searchFilters"
                                                t-as="filter"
                                                t-key="filter.id"
                                            >
                                                <option
                                                    t-att-value="filter.id"
                                                    t-att-selected="state.selectedFilterIds.has(filter.id) ? 'selected' : undefined"
                                                    style="padding: 4px 8px;"
                                                >
                                                    <t t-esc="filter.name" />
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div
                                        t-attf-class="col-lg-{{ this.hidePartnerType ? '2' : '2' }} col-md-2"
                                    >
                                        <label for="search_field" class="form-label fw-bold">
                                            <i class="fa fa-search me-1" /> Search By
                                        </label>
                                        <select
                                            id="search_field"
                                            class="form-select form-select-lg"
                                            t-model="state.selectedField"
                                            t-on-change="onFieldChange"
                                        >
                                            <t t-foreach="state.searchFields" t-as="field" t-key="field.id">
                                                <option t-att-value="field.field_name">
                                                    <t t-esc="field.name" />
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div
                                        t-attf-class="col-lg-{{ this.hidePartnerType ? '3' : '3' }} col-md-3"
                                    >
                                        <label for="search_value" class="form-label fw-bold">
                                            <i class="fa fa-keyboard-o me-1" /> Search Value
                                        </label>
                                        <!-- Show selection dropdown for relational fields -->
                                        <t
                                            t-if="state.selectedFieldInfo and (state.selectedFieldInfo.field_type === 'selection' or state.selectedFieldInfo.field_type === 'many2one') and state.fieldOptions.length > 0"
                                        >
                                            <select
                                                id="search_value"
                                                class="form-select form-select-lg"
                                                t-model="state.searchValue"
                                                t-on-change="onSearchValueChange"
                                            >
                                                <option value="">-- Select --</option>
                                                <t
                                                    t-foreach="state.fieldOptions"
                                                    t-as="option"
                                                    t-key="option[0]"
                                                >
                                                    <option
                                                        t-att-value="option[0]"
                                                        t-att-selected="state.searchValue == option[0] ? 'selected' : undefined"
                                                    >
                                                        <t t-esc="option[1]" />
                                                    </option>
                                                </t>
                                            </select>
                                        </t>
                                        <!-- Show text input for other field types -->
                                        <t t-else="">
                                            <input
                                                type="text"
                                                id="search_value"
                                                class="form-control form-control-lg"
                                                placeholder="Enter search value..."
                                                t-model="state.searchValue"
                                                t-on-input="onSearchValueChange"
                                                t-on-keypress="onKeyPress"
                                            />
                                        </t>
                                    </div>
                                    <div class="col-lg-2 col-md-2">
                                        <label
                                            class="form-label fw-bold"
                                            style="visibility: hidden;"
                                        >Action</label>
                                        <div class="d-grid gap-2">
                                            <button
                                                class="btn btn-primary btn-lg"
                                                t-on-click="onSearch"
                                                t-att-disabled="state.searching or !state.selectedField"
                                            >
                                                <i class="fa fa-search me-1" />
                                                <t t-if="!state.searching">Search</t>
                                                <t t-else="">
                                                    <i class="fa fa-spinner fa-spin" /> Searching...
                                                </t>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <!-- Selected Filters Badges Row -->
                                <div class="row mt-2" t-if="state.selectedFilterIds.size > 0">
                                    <div class="col-12">
                                        <div class="d-flex align-items-center flex-wrap">
                                            <span class="me-2 text-muted">
                                                <small>
                                                    <i class="fa fa-filter me-1" />Active Filters:
                                                </small>
                                            </span>
                                            <t
                                                t-foreach="Array.from(state.selectedFilterIds)"
                                                t-as="filterId"
                                                t-key="filterId"
                                            >
                                                <t
                                                    t-set="filter"
                                                    t-value="state.searchFilters.find(f => f.id === filterId)"
                                                />
                                                <t t-if="filter">
                                                    <span class="badge bg-primary me-1 mb-1">
                                                        <t t-esc="filter.name" />
                                                        <i
                                                            class="fa fa-times ms-1"
                                                            style="cursor: pointer;"
                                                            t-on-click="() => this.removeFilter(filterId)"
                                                            title="Remove filter"
                                                        />
                                                    </span>
                                                </t>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                                <!-- Action Buttons Row -->
                                <div class="row g-3 mt-2">
                                    <div class="col-12">
                                        <div class="btn-group" role="group">
                                            <button
                                                class="btn btn-success"
                                                t-on-click="onCreate"
                                                title="Create New Registrant"
                                            >
                                                <i class="fa fa-plus me-1" /> Create
                                            </button>
                                            <button
                                                class="btn btn-outline-secondary"
                                                t-on-click="onImport"
                                                title="Import Registrants"
                                            >
                                                <i class="fa fa-upload me-1" /> Import
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3 text-muted">
                                    <small>
                                        <i class="fa fa-info-circle me-1" />
                                        Select filters (Ctrl+Click for multiple - uses OR logic), choose a search field, and enter a value. Leave search value empty to list all. No filters = active registrants only.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Search Results -->
                <div class="row" t-if="state.showResults">
                    <div class="col-12">
                        <div class="card shadow-sm border-0">
                            <div
                                class="card-header bg-light d-flex justify-content-between align-items-center py-3"
                            >
                                <h5 class="mb-0">
                                    <i class="fa fa-list me-2" /> Search Results
                                    <span class="badge bg-primary ms-2">
                                        <t t-esc="state.results.length" />
                                    </span>
                                    <t t-if="this.hasSelections">
                                        <span class="badge bg-success ms-2">
                                            <t t-esc="state.selectedIds.size" /> selected
                                        </span>
                                    </t>
                                </h5>
                                <div>
                                    <div class="btn-group me-2">
                                        <div class="dropdown">
                                            <button
                                                class="btn btn-sm btn-primary dropdown-toggle"
                                                type="button"
                                                id="actionDropdown"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                t-att-disabled="!this.hasSelections"
                                            >
                                                <i class="fa fa-cog me-1" /> Action
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="actionDropdown">
                                                <li>
                                                    <a
                                                        class="dropdown-item"
                                                        href="#"
                                                        t-on-click.prevent="onExport"
                                                    >
                                                        <i class="fa fa-download me-2" />
                                                        Export
                                                    </a>
                                                </li>
                                                <t t-if="this.isArchivedFilterSelected">
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li>
                                                        <a
                                                            class="dropdown-item text-success"
                                                            href="#"
                                                            t-on-click.prevent="onUnarchiveSelected"
                                                        >
                                                            <i class="fa fa-folder-open me-2" />
                                                            Unarchive
                                                        </a>
                                                    </li>
                                                </t>
                                                <t t-else="">
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li>
                                                        <a
                                                            class="dropdown-item text-danger"
                                                            href="#"
                                                            t-on-click.prevent="onArchiveSelected"
                                                        >
                                                            <i class="fa fa-archive me-2" />
                                                            Archive
                                                        </a>
                                                    </li>
                                                </t>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="btn-group">
                                        <button
                                            class="btn btn-sm btn-outline-primary"
                                            t-on-click="onSelectAll"
                                            t-att-disabled="state.results.length === 0"
                                        >
                                            <i class="fa fa-check-square-o me-1" /> Select All
                                        </button>
                                        <button
                                            class="btn btn-sm btn-outline-secondary"
                                            t-on-click="onDeselectAll"
                                            t-att-disabled="!this.hasSelections"
                                        >
                                            <i class="fa fa-square-o me-1" /> Deselect All
                                        </button>
                                        <button
                                            class="btn btn-sm btn-outline-secondary"
                                            t-on-click="onClearSearch"
                                        >
                                            <i class="fa fa-times me-1" /> Clear
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="state.results.length > 0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 40px;">
                                                        <input
                                                            type="checkbox"
                                                            class="form-check-input"
                                                            t-att-checked="this.allSelected"
                                                            t-on-change="this.allSelected ? onDeselectAll : onSelectAll"
                                                        />
                                                    </th>
                                                    <th>Name</th>
                                                    <th>Address</th>
                                                    <th>Phone</th>
                                                    <th>Tags</th>
                                                    <th
                                                        t-if="state.partnerType === 'individual'"
                                                    >Birthdate</th>
                                                    <th>Registration Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t
                                                    t-foreach="state.results"
                                                    t-as="partner"
                                                    t-key="partner.id"
                                                >
                                                    <tr
                                                        class="o_data_row cursor-pointer"
                                                        t-on-click="(ev) => this.onRowClick(ev, partner.id, partner.is_group)"
                                                        style="cursor: pointer;"
                                                    >
                                                        <td t-on-click.stop="">
                                                            <input
                                                                type="checkbox"
                                                                class="form-check-input"
                                                                t-att-checked="this.isSelected(partner.id)"
                                                                t-on-change="() => this.onSelectRecord(partner.id)"
                                                            />
                                                        </td>
                                                        <td>
                                                            <span
                                                                class="fw-bold"
                                                                t-att-class="{ 'text-muted': !partner.active }"
                                                            >
                                                                <t t-esc="partner.name" />
                                                            </span>
                                                            <t t-if="!partner.active">
                                                                <span class="badge bg-secondary ms-2">
                                                                    <i class="fa fa-archive" /> Archived
                                                                </span>
                                                            </t>
                                                        </td>
                                                        <td>
                                                            <t t-esc="partner.address or '-'" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="partner.phone or '-'" />
                                                        </td>
                                                        <td>
                                                            <t
                                                                t-if="partner.tags_ids and partner.tags_ids.length > 0"
                                                            >
                                                                <t
                                                                    t-foreach="partner.tags_ids"
                                                                    t-as="tag"
                                                                    t-key="tag[0]"
                                                                >
                                                                    <span class="badge bg-secondary me-1">
                                                                        <t t-esc="tag[1]" />
                                                                    </span>
                                                                </t>
                                                            </t>
                                                            <t t-else="">-</t>
                                                        </td>
                                                        <td t-if="state.partnerType === 'individual'">
                                                            <t t-esc="partner.birthdate or '-'" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="partner.registration_date or '-'" />
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center py-5 text-muted">
                                        <i class="fa fa-search fa-3x mb-3 opacity-25" />
                                        <h5>No registrants found</h5>
                                        <p>Try adjusting your search criteria</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
