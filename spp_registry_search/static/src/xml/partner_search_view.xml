<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="spp_registry_search.PartnerSearchAction" owl="1">
        <div class="o_partner_search_action vh-100 overflow-auto">
            <div class="container-fluid py-4 px-4">
                <!-- Search Form -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-primary text-white py-3">
                                <h4 class="mb-0">
                                    <i class="fa fa-search me-2" /> Registry Search
                                </h4>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3 align-items-end">
                                    <div class="col-lg-2 col-md-3">
                                        <label for="partner_type" class="form-label fw-bold">
                                            <i class="fa fa-users me-1" /> Registrant Type
                                        </label>
                                        <select
                                            id="partner_type"
                                            class="form-select form-select-lg"
                                            t-model="state.partnerType"
                                            t-on-change="onPartnerTypeChange"
                                        >
                                            <option value="individual">Individual</option>
                                            <option value="group">Group</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-2 col-md-3">
                                        <label for="search_field" class="form-label fw-bold">
                                            <i class="fa fa-filter me-1" /> Search By
                                        </label>
                                        <select
                                            id="search_field"
                                            class="form-select form-select-lg"
                                            t-model="state.selectedField"
                                            t-on-change="onFieldChange"
                                        >
                                            <t t-foreach="state.searchFields" t-as="field" t-key="field.id">
                                                <option t-att-value="field.field_name">
                                                    <t t-esc="field.name" />
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-lg-6 col-md-4">
                                        <label for="search_value" class="form-label fw-bold">
                                            <i class="fa fa-keyboard-o me-1" /> Search Value
                                        </label>
                                        <input
                                            type="text"
                                            id="search_value"
                                            class="form-control form-control-lg"
                                            placeholder="Enter search value..."
                                            t-model="state.searchValue"
                                            t-on-input="onSearchValueChange"
                                            t-on-keypress="onKeyPress"
                                        />
                                    </div>
                                    <div class="col-lg-2 col-md-2">
                                        <div class="d-grid gap-2">
                                            <button
                                                class="btn btn-primary btn-lg"
                                                t-on-click="onSearch"
                                                t-att-disabled="state.searching or !state.selectedField or !state.searchValue"
                                            >
                                                <i class="fa fa-search me-1" />
                                                <t t-if="!state.searching">Search</t>
                                                <t t-else="">
                                                    <i class="fa fa-spinner fa-spin" /> Searching...
                                                </t>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3 text-muted">
                                    <small>
                                        <i class="fa fa-info-circle me-1" />
                                        Select registrant type (Individual or Group), choose a field from the dropdown, and enter a search value. Press Enter or click Search button.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Search Results -->
                <div class="row" t-if="state.showResults">
                    <div class="col-12">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
                                <h5 class="mb-0">
                                    <i class="fa fa-list me-2" /> Search Results
                                    <span class="badge bg-primary ms-2">
                                        <t t-esc="state.results.length" />
                                    </span>
                                </h5>
                                <button
                                    class="btn btn-sm btn-outline-secondary"
                                    t-on-click="onClearSearch"
                                >
                                    <i class="fa fa-times me-1" /> Clear
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="state.results.length > 0">
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Type</th>
                                                    <th>Name</th>
                                                    <th>Email</th>
                                                    <th>Phone</th>
                                                    <th>Mobile</th>
                                                    <th>City</th>
                                                    <th>Country</th>
                                                    <th class="text-end">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="state.results" t-as="partner" t-key="partner.id">
                                                    <tr>
                                                        <td>
                                                            <span t-if="partner.is_group" class="badge bg-info">
                                                                <i class="fa fa-users me-1" /> Group
                                                            </span>
                                                            <span t-else="" class="badge bg-success">
                                                                <i class="fa fa-user me-1" /> Individual
                                                            </span>
                                                        </td>
                                                        <td class="fw-bold">
                                                            <t t-esc="partner.name" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="partner.email or '-'" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="partner.phone or '-'" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="partner.mobile or '-'" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="partner.city or '-'" />
                                                        </td>
                                                        <td>
                                                            <t t-esc="partner.country_id ? partner.country_id[1] : '-'" />
                                                        </td>
                                                        <td class="text-end">
                                                            <button
                                                                class="btn btn-sm btn-primary"
                                                                t-on-click="() => this.openPartner(partner.id)"
                                                            >
                                                                <i class="fa fa-external-link me-1" /> Open
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center py-5 text-muted">
                                        <i class="fa fa-search fa-3x mb-3 opacity-25" />
                                        <h5>No registrants found</h5>
                                        <p>Try adjusting your search criteria</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>

