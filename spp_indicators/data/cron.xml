<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <record id="ir_cron_openspp_metrics_purge_expired" model="ir.cron">
    <field name="name">OpenSPP Metrics: Purge Expired Values</field>
    <field name="model_id" ref="model_openspp_indicator_value" />
    <field name="state">code</field>
    <field name="code">model.cron_purge_expired()</field>
    <field name="interval_number">6</field>
    <field name="interval_type">hours</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
  </record>

  <record id="ir_cron_openspp_indicators_purge_push_errors" model="ir.cron">
    <field name="name">OpenSPP Indicators: Purge Push Errors</field>
    <field name="model_id" ref="model_openspp_indicator_push_error" />
    <field name="state">code</field>
    <field name="code">model.cron_purge_old()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
  </record>
</odoo>
