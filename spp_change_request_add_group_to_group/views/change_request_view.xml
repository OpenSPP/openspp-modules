<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_change_request_add_group_to_group_custom_form" model="ir.ui.view">
        <field name="name">view_change_request_add_group_to_group_custom_form</field>
        <field name="model">spp.change.request</field>
        <field name="inherit_id" ref="spp_change_request.view_change_request_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='applicant_id']" position="attributes">
                <attribute name="required">'add.group.to.group' not in request_type</attribute>
            </xpath>
            <xpath expr="//label[@for='applicant_id']" position="attributes">
                <attribute name="invisible">'add.group.to.group' in request_type</attribute>
            </xpath>
            <xpath expr="//field[@name='applicant_id']" position="attributes">
                <attribute name="invisible">'add.group.to.group' in request_type</attribute>
            </xpath>
            <xpath expr="//group[1]" position="attributes">
                <attribute name="invisible">'add.group.to.group' in request_type</attribute>
            </xpath>
        </field>
    </record>
</odoo>
