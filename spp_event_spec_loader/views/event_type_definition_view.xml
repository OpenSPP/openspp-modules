<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_spp_event_type_definition_tree" model="ir.ui.view">
        <field name="name">view_spp_event_type_definition_tree</field>
        <field name="model">spp.event.type.definition</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="technical_name" />
                <field name="program_spec_id" />
                <field name="source" />
                <field name="model_deployed" widget="boolean_toggle" />
                <field name="view_deployed" widget="boolean_toggle" />
                <field
                    name="state"
                    decoration-info="state=='draft'"
                    decoration-success="state=='deployed'"
                    decoration-danger="state=='error'"
                    widget="badge"
                />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_spp_event_type_definition_form" model="ir.ui.view">
        <field name="name">view_spp_event_type_definition_form</field>
        <field name="model">spp.event.type.definition</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <form string="Event Type Definition">
                <header>
                    <button
                        name="action_deploy"
                        string="Deploy"
                        type="object"
                        invisible="state == 'deployed'"
                        class="oe_highlight"
                        confirm="This will create the model, views, and wizard. Continue?"
                    />
                    <button
                        name="action_undeploy"
                        string="Undeploy"
                        type="object"
                        invisible="state != 'deployed'"
                        confirm="This will remove views but preserve data. Continue?"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Event Type Name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="technical_name" />
                            <field name="program_spec_id" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="source" />
                            <field name="source_ref" />
                            <field name="active" />
                        </group>
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                    <notebook>
                        <page name="fields" string="Field Definitions">
                            <group>
                                <field
                                    name="field_definitions"
                                    widget="ace"
                                    options="{'mode': 'json'}"
                                    nolabel="1"
                                />
                            </group>
                        </page>
                        <page name="deployment" string="Deployment Status">
                            <group>
                                <group>
                                    <field name="model_deployed" />
                                    <field name="view_deployed" />
                                    <field name="wizard_deployed" />
                                </group>
                            </group>
                            <group invisible="not error_message">
                                <field name="error_message" nolabel="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_spp_event_type_definition_search" model="ir.ui.view">
        <field name="name">view_spp_event_type_definition_search</field>
        <field name="model">spp.event.type.definition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="technical_name" />
                <field name="program_spec_id" />
                <filter name="deployed" string="Deployed" domain="[('state','=','deployed')]" />
                <filter name="draft" string="Draft" domain="[('state','=','draft')]" />
                <filter name="error" string="Error" domain="[('state','=','error')]" />
                <group expand="0" string="Group By">
                    <filter name="group_program" string="Program" context="{'group_by':'program_spec_id'}" />
                    <filter name="group_source" string="Source" context="{'group_by':'source'}" />
                    <filter name="group_state" string="State" context="{'group_by':'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spp_event_type_definition" model="ir.actions.act_window">
        <field name="name">Event Type Definitions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.event.type.definition</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Event Type Definitions Found!
            </p>
            <p>
                Event types are automatically created from Program Specifications.
            </p>
        </field>
    </record>
</odoo>
