<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_spp_program_spec_tree" model="ir.ui.view">
        <field name="name">view_spp_program_spec_tree</field>
        <field name="model">spp.program.spec</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="currency" />
                <field name="event_type_count" />
                <field name="last_deployed" />
                <field
                    name="state"
                    decoration-info="state=='draft'"
                    decoration-success="state in ['validated','deployed']"
                    decoration-danger="state=='error'"
                    widget="badge"
                />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_spp_program_spec_form" model="ir.ui.view">
        <field name="name">view_spp_program_spec_form</field>
        <field name="model">spp.program.spec</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <form string="Program Specification">
                <header>
                    <button
                        name="action_validate"
                        string="Validate"
                        type="object"
                        invisible="state not in ['draft','error']"
                        class="oe_highlight"
                    />
                    <button
                        name="action_deploy"
                        string="Deploy Event Types"
                        type="object"
                        invisible="state != 'validated'"
                        class="oe_highlight"
                        confirm="This will create event type models and views. Continue?"
                    />
                    <button
                        name="action_reset_to_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state == 'draft'"
                    />
                    <button
                        name="action_export_yaml"
                        string="Export YAML"
                        type="object"
                        invisible="not yaml_content"
                        class="btn-secondary"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_event_types"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                        >
                            <field name="event_type_count" widget="statinfo" string="Event Types" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Program Name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="currency" />
                            <field name="languages" />
                            <field name="last_deployed" />
                        </group>
                    </group>
                    <notebook>
                        <page name="yaml_spec" string="YAML Specification">
                            <group>
                                <group colspan="2">
                                    <field name="yaml_file" filename="yaml_filename" />
                                    <field name="yaml_filename" invisible="1" />
                                </group>
                            </group>
                            <separator string="YAML Content" />
                            <field name="yaml_content" widget="ace" options="{'mode': 'yaml'}" nolabel="1" />
                        </page>
                        <page name="metadata" string="Program Metadata">
                            <group>
                                <group>
                                    <field name="program_objectives" />
                                    <field name="implementing_agencies" />
                                </group>
                            </group>
                        </page>
                        <page name="parsed_data" string="Parsed Data">
                            <group>
                                <field
                                    name="spec_data"
                                    widget="ace"
                                    options="{'mode': 'json'}"
                                    nolabel="1"
                                    readonly="1"
                                />
                            </group>
                        </page>
                        <page name="errors" string="Errors" invisible="not error_message">
                            <group>
                                <field name="error_message" nolabel="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_spp_program_spec_search" model="ir.ui.view">
        <field name="name">view_spp_program_spec_search</field>
        <field name="model">spp.program.spec</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <filter name="draft" string="Draft" domain="[('state','=','draft')]" />
                <filter name="validated" string="Validated" domain="[('state','=','validated')]" />
                <filter name="deployed" string="Deployed" domain="[('state','=','deployed')]" />
                <filter name="error" string="Error" domain="[('state','=','error')]" />
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by':'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_spp_program_spec" model="ir.actions.act_window">
        <field name="name">Program Specifications</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">spp.program.spec</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Program Specification!
            </p>
            <p>
                Upload or paste a YAML program specification to automatically generate event types.
            </p>
        </field>
    </record>
</odoo>
