<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="spp_oauth_config_view" model="ir.ui.view">
        <field name="name">spp_oauth_config_view</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="999" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    string="SPP OAuth Settings"
                    name="spp_oauth_config_settings"
                    logo="/spp_attendance/static/description/icon.png"
                >
                    <block title="OAuth Settings">
                        <setting string="Private Key">
                            <field name="oauth_priv_key" password="true"/>
                        </setting>
                        <setting string="Public Key">
                            <field name="oauth_pub_key" password="true"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
