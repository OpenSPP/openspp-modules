<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_code_generator_tree" model="ir.ui.view">
        <field name="name">spp.code.generator.tree</field>
        <field name="model">spp.code.generator</field>
        <field name="arch" type="xml">
            <tree string="Code Generators">
                <field name="name" string="YAML Filename" />
                <field name="description" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'processed'"
                    decoration-info="state == 'draft'"
                />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_code_generator_form" model="ir.ui.view">
        <field name="name">spp.code.generator.form</field>
        <field name="model">spp.code.generator</field>
        <field name="arch" type="xml">
            <form string="Code Generator">
                <header>
                    <button
                        name="action_process_entities"
                        type="object"
                        string="Process Entities"
                        class="oe_highlight"
                        invisible="state == 'processed'"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field
                                name="name"
                                readonly="1"
                                force_save="1"
                                placeholder="Filename will appear here..."
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="yaml_file" filename="name" />
                        </group>
                        <group />
                    </group>
                    <group>
                        <field name="description" placeholder="Add a description..." />
                    </group>
                    <notebook>
                        <page string="Processing Log">
                            <field name="processing_log" widget="text" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_code_generator_search" model="ir.ui.view">
        <field name="name">spp.code.generator.search</field>
        <field name="model">spp.code.generator</field>
        <field name="arch" type="xml">
            <search string="Search Code Generators">
                <field name="name" string="Filename" filter_domain="[('name', 'ilike', self)]" />
                <field name="description" />
                <separator />
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]" />
                <filter string="Processed" name="filter_processed" domain="[('state', '=', 'processed')]" />
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_code_generator" model="ir.actions.act_window">
        <field name="name">Code Generators</field>
        <field name="res_model">spp.code.generator</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_code_generator_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first YAML Configuration
            </p>
            <p>
                Upload YAML files to configure code generation. The system will validate the YAML syntax automatically.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_code_generator_root" name="Code Generator" sequence="100" />

    <menuitem
        id="menu_code_generator"
        name="Code Generators"
        parent="menu_code_generator_root"
        action="action_code_generator"
        sequence="10"
    />
</odoo>
