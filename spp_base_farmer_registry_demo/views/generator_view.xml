<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_demo_data_generator_farmer_registry_form" model="ir.ui.view">
        <field name="name">view_demo_data_generator_farmer_registry_form</field>
        <field name="model">spp.demo.data.generator</field>
        <field name="inherit_id" ref="spp_demo_common.view_demo_data_generator_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='generated_group_ids']" position="attributes">
                <attribute
                    name="context"
                >{'form_view_ref': 'spp_base_farmer_registry.view_farm_groups_form'}</attribute>
            </xpath>
            <xpath expr="//field[@name='generated_individual_ids']" position="attributes">
                <attribute
                    name="context"
                >{'form_view_ref': 'spp_base_farmer_registry.view_individuals_form'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
