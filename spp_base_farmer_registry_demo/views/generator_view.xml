<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_farm_groups_form" model="ir.ui.view">
        <field name="name">view_farm_groups_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="spp_base_farmer_registry.view_farm_groups_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='generated_group_ids']" position="attributes">
                <attribute
                    name="context"
                >{'form_view_ref': 'spp_base_farmer_registry.view_farm_groups_form'}</attribute>
            </xpath>
            <xpath expr="//field[@name='generated_individual_ids']" position="attributes">
                <attribute
                    name="context"
                >{'form_view_ref': 'spp_base_farmer_registry.view_individuals_form'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
