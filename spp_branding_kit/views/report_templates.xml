<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <!-- External Layout Footer - Add OpenSPP branding -->
        <template
        id="custom_external_layout_footer"
        inherit_id="web.external_layout_standard"
        name="OpenSPP Report Footer"
    >
            <xpath expr="//div[@t-field='company.report_footer']" position="after">
                <div class="text-center mt-2">
                    <small class="text-muted">Generated by OpenSPP Platform</small>
                </div>
            </xpath>
        </template>
</odoo>
